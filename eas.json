{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },

  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",

      "env": {
        "APP_VARIANT": "development"
      }
    },

    "preview": {
      "distribution": "internal",

      "android": {
        "buildType": "apk"
      },

      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.15.2:8000"
      }
    },

    "production": {
      "autoIncrement": true,

      "env": {
        "APP_VARIANT": "production"
      }
    }
  },

  "submit": {
    "production": {}
  }
}